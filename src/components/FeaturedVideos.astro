---
import {YoutubeIcon} from "lucide-svelte";
import SectionHeader from "./SectionHeader.astro";
interface Video {
  id: string;
  title: string;
  description: string;
}

interface Props {
  videos?: Video[];
}

const {
  videos = [
    {
      id: "03y826SVjG0",
      title: "Jak wybrać najlepszego Agenta AI do programowania?",
      description:
        "A guide to picking the best AI coding agent for your daily development workflow.",
    },
    {
      id: "pX1Gj3rTc_o",
      title: "10x LEPSZY PROGRAMISTA? Programowanie z AI od startu do mety",
      description:
        "Doing AI-assisted programming the right way - from project kickoff all the way to the finish line.",
    },
    {
      id: "uwi39C2O8NI",
      title: "5 technik, które naprawiły mój workflow programowania z AI",
      description:
        "Five practical techniques that transformed my day-to-day AI programming workflow.",
    },
  ],
} = Astro.props;
---

<div class='max-w-screen-xl mx-auto py-12 px-4 sm:px-6 lg:px-8'>
  <SectionHeader
    title='Featured videos'
    subtitle='Some of my most popular videos.'
  />

  <div class='mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3'>
    {
      videos.map((video) => (
        <div class='bg-gray-900/50 backdrop-blur-sm border border-gray-800/30 rounded-lg overflow-hidden'>
          <div class='relative pt-[56.25%]'>
            <iframe
              class='absolute top-0 left-0 w-full h-full'
              src={`https://www.youtube.com/embed/${video.id}`}
              title={video.title}
              allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
              allowfullscreen
            />
          </div>
          <div class='py-6'>
            <div class='flex items-center'>
              <YoutubeIcon class='w-5 h-5 text-gray-400' />
              <h3 class='ml-2 text-lg font-medium text-gray-200'>
                {video.title}
              </h3>
            </div>
            <p class='mt-4 text-gray-400'>{video.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
